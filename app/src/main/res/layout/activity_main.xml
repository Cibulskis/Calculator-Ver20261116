<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp"
    android:paddingTop="8dp">

    <!-- Antraštė: Hamburger, Standard, Laikyti viršuje, Istorija -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_header_icon_background"
            android:contentDescription="@string/cd_menu"
            android:src="@drawable/ic_menu"
            app:tint="@color/icon_tint" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/header_standard"
            android:textColor="@color/text_display"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnKeepOnTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_header_icon_background"
            android:contentDescription="@string/cd_keep_on_top"
            android:src="@drawable/ic_keep_on_top"
            app:tint="@color/icon_tint" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_header_icon_background"
            android:contentDescription="@string/cd_history"
            android:src="@drawable/ic_history"
            app:tint="@color/icon_tint" />
    </LinearLayout>

    <!-- Ekranas: atlikta išraiška (pvz., "12 + 8 =") -->
    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|bottom"
        android:minHeight="28dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/text_expression"
        android:textSize="17sp"
        tools:text="12 + 8 =" />

    <!-- Ekranas: pagrindinis skaičius (pvz., "20") -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="end|bottom"
        android:maxLines="1"
        android:minHeight="68dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:text="0"
        android:textColor="@color/text_display"
        android:textSize="52sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="56sp"
        app:autoSizeMinTextSize="24sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        tools:text="20" />

    <!-- Atminties juosta: MC, MR, M+, M-, MS, Mv -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMC"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_memory_background"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/btn_mc"
            android:textAllCaps="false"
            android:textColor="@color/text_memory_disabled"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMR"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_memory_background"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/btn_mr"
            android:textAllCaps="false"
            android:textColor="@color/text_memory_disabled"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMPlus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_memory_background"
            android:stateListAnimator="@null"
            android:text="@string/btn_m_plus"
            android:textAllCaps="false"
            android:textColor="@color/text_memory_active"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMMinus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_memory_background"
            android:stateListAnimator="@null"
            android:text="@string/btn_m_minus"
            android:textAllCaps="false"
            android:textColor="@color/text_memory_active"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMS"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_memory_background"
            android:stateListAnimator="@null"
            android:text="@string/btn_ms"
            android:textAllCaps="false"
            android:textColor="@color/text_memory_active"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_memory_background"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/btn_m_list"
            android:textAllCaps="false"
            android:textColor="@color/text_memory_disabled"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Mygtukų tinklelis (6 eilutės x 4 stulpeliai) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 1 Eilutė: %, CE, C, ⌫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPercent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_percent"
                android:stateListAnimator="@null"
                android:text="@string/btn_percent"
                android:textColor="@color/text_btn_operator"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCE"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_ce"
                android:stateListAnimator="@null"
                android:text="@string/btn_ce"
                android:textColor="@color/text_btn_operator"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_c"
                android:stateListAnimator="@null"
                android:text="@string/btn_c"
                android:textColor="@color/text_btn_operator"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_backspace"
                android:scaleType="centerInside"
                android:src="@drawable/ic_backspace"
                android:stateListAnimator="@null"
                app:tint="@color/icon_tint" />
        </LinearLayout>

        <!-- 2 Eilutė: 1/x, x², ²√x, ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReciprocal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_reciprocal"
                android:stateListAnimator="@null"
                android:text="@string/btn_reciprocal"
                android:textColor="@color/text_btn_operator"
                android:textSize="17sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSquare"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_square"
                android:stateListAnimator="@null"
                android:text="@string/btn_square"
                android:textColor="@color/text_btn_operator"
                android:textSize="17sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSquareRoot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_sqrt"
                android:stateListAnimator="@null"
                android:text="@string/btn_sqrt"
                android:textColor="@color/text_btn_operator"
                android:textSize="17sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_divide"
                android:stateListAnimator="@null"
                android:text="@string/btn_divide"
                android:textColor="@color/text_btn_operator"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 3 Eilutė: 7, 8, 9, × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_7"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_8"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_9"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_multiply"
                android:stateListAnimator="@null"
                android:text="@string/btn_multiply"
                android:textColor="@color/text_btn_operator"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 4 Eilutė: 4, 5, 6, − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_4"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_5"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_6"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_subtract"
                android:stateListAnimator="@null"
                android:text="@string/btn_subtract"
                android:textColor="@color/text_btn_operator"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- 5 Eilutė: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_1"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_2"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_3"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_operator_background"
                android:contentDescription="@string/cd_add"
                android:stateListAnimator="@null"
                android:text="@string/btn_add"
                android:textColor="@color/text_btn_operator"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 6 Eilutė: ⁺/₋, 0, ., = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNegate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:contentDescription="@string/cd_negate"
                android:stateListAnimator="@null"
                android:text="@string/btn_negate"
                android:textColor="@color/text_btn_number"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:stateListAnimator="@null"
                android:text="@string/btn_0"
                android:textColor="@color/text_btn_number"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_number_background"
                android:contentDescription="@string/cd_dot"
                android:stateListAnimator="@null"
                android:text="@string/btn_dot"
                android:textColor="@color/text_btn_number"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/btn_equals_background"
                android:contentDescription="@string/cd_equals"
                android:stateListAnimator="@null"
                android:text="@string/btn_equals"
                android:textColor="@color/text_btn_equals"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>